<div class="mt-4 mb-4">
    <h3>Sửa khóa học</h3>

    <form id="editCourseForm" autocomplete="off" method="post" action="/courses/{{course._id}}?_method=PUT"
        enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Tên khóa học</label>
            <input type="text" class="form-control" value="{{course.title}}" id="title" name="title" required>
            <div id="titleHelp" class="form-text">Ví dụ: Tiếng Anh Cơ Bản</div>
        </div>

        <div class="mb-3">
            <label for="thumbnail" class="form-label">Ảnh thumbnail khóa học</label>
            <input class="form-control" type="file" name="thumbnail" id="thumbnail" accept="image/*">
            <div id="thumbnailHelp" class="form-text">Kích thước ảnh khuyên dùng là 1280 x 720 px</div>

            <!-- Hiển thị ảnh thumbnail hiện tại -->
            <div class="mt-2">
                <p class="text-muted">Ảnh hiện tại:</p>
                <img src="{{course.thumbnail}}" alt="Thumbnail hiện tại" class="img-thumbnail"
                    style="max-width: 300px; max-height: 200px;">
            </div>

            <!-- Hiển thị ảnh preview khi chọn ảnh mới -->
            <div class="mt-2">
                <p class="text-muted">Ảnh mới (nếu có):</p>
                <img id="imagePreview" src="" alt="Ảnh xem trước"
                    style="max-width: 300px; max-height: 200px; display: none;" class="img-thumbnail">
            </div>

            <!-- Giữ lại đường dẫn ảnh cũ trong trường hợp không upload ảnh mới -->
            <input type="hidden" name="currentThumbnail" value="{{course.thumbnail}}">
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Mô tả</label>
            <textarea class="form-control" id="description" name="description"
                required>{{course.description}}</textarea>
            <div id="descriptionHelp" class="form-text">Ví dụ: Đây là khóa học về ...</div>
        </div>

        <div class="mb-3">
            <label class="form-label d-block">Hiển thị</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="isActive" id="isActiveYes" value="true" {{#if
                    course.isActive}}checked{{/if}}>
                <label class="form-check-label" for="isActiveYes">
                    Có
                </label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="isActive" id="isActiveNo" value="false" {{#unless
                    course.isActive}}checked{{/unless}}>
                <label class="form-check-label" for="isActiveNo">
                    Không
                </label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label d-block">Khóa học Premium</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="isPremium" id="isPremiumYes" value="true" {{#if
                    course.isPremium}}checked{{/if}}>
                <label class="form-check-label" for="isPremiumYes">
                    Phải
                </label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="isPremium" id="isPremiumNo" value="false" {{#unless
                    course.isPremium}}checked{{/unless}}>
                <label class="form-check-label" for="isPremiumNo">
                    Không phải
                </label>
            </div>
        </div>

        <div class="mb-3 {{#unless course.isPremium}}d-none{{/unless}}" id="priceField">
            <label for="price" class="form-label">Giá gốc</label>
            <input type="number" class="form-control" id="price" name="price" min="0" value="{{course.price}}">
            <div class="form-text">Nếu 1.000.000 VND thì viết là 1000000</div>
        </div>

        <div class="mb-3 {{#unless course.isPremium}}d-none{{/unless}}" id="salePriceField">
            <label for="salePrice" class="form-label">Giảm còn (Nếu muốn giảm giá)</label>
            <input type="number" class="form-control" id="salePrice" name="salePrice" min="0"
                value="{{course.salePrice}}">
            <div class="form-text">Muốn giữ giá gốc thì không cần nhập hoặc nhập 0</div>
        </div>

        {{!-- Giá cuối cùng của khóa học là --}}
        <div class="mb-3 {{#unless course.isPremium}}d-none{{/unless}}" id="finalPriceField">
            <label for="finalPrice" class="form-label">Giá cuối cùng</label>
            <p id="finalPrice">0 VND</p>
        </div>

        <div class="mb-3 {{#unless course.isPremium}}d-none{{/unless}}" id="percentagePriceReduceField">
            <label for="percentagePriceReduce" class="form-label">Đã giảm (%)</label>
            <p id="percentagePriceReduce">0 %</p>
        </div>

        {{#if error}}
        <div class="alert alert-danger" role="alert">
            {{error}}
        </div>
        {{/if}}

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a href="/courses/stored-courses" class="btn btn-secondary">Hủy</a>
    </form>
</div>

<!-- Script xử lý hiển thị ảnh preview và tính giá -->
<script>
    document.getElementById('thumbnail').addEventListener('change', function (event) {
        const imagePreview = document.getElementById('imagePreview');
        const file = event.target.files[0];

        if (file) {
            // Hiển thị ảnh preview
            const reader = new FileReader();
            reader.onload = function (e) {
                imagePreview.src = e.target.result;
                imagePreview.style.display = 'block';
            }
            reader.readAsDataURL(file);
        } else {
            // Ẩn ảnh preview nếu không có file được chọn
            imagePreview.src = '';
            imagePreview.style.display = 'none';
        }
    });

    // Script xử lý ẩn/hiện và validate trường giá
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('editCourseForm');
        const premiumRadios = document.querySelectorAll('input[name="isPremium"]');
        const priceField = document.getElementById('priceField');
        const salePriceField = document.getElementById('salePriceField');
        const finalPriceField = document.getElementById('finalPriceField');
        const percentagePriceReduceField = document.getElementById('percentagePriceReduceField');
        const priceInput = document.getElementById('price');
        const salePriceInput = document.getElementById('salePrice');
        const finalPrice = document.getElementById('finalPrice');
        const percentagePriceReduce = document.getElementById('percentagePriceReduce');

        function formatVND(number) {
            return new Intl.NumberFormat('vi-VN').format(number) + ' VND';
        }

        function updateFinalPrice() {
            const isPremiumSelected = document.getElementById('isPremiumYes').checked;
            if (isPremiumSelected) {
                const priceValue = parseInt(priceInput.value, 10) || 0;
                const salePriceValue = parseInt(salePriceInput.value, 10) || 0;

                finalPriceField.classList.remove('d-none');
                percentagePriceReduceField.classList.remove('d-none');

                // Tính giá cuối cùng
                let displayPrice = priceValue;
                let percentage = 0;

                if (salePriceValue > 0 && salePriceValue < priceValue) {
                    displayPrice = salePriceValue;
                    percentage = Math.round((1 - salePriceValue / priceValue) * 100);
                }
                percentagePriceReduce.textContent = percentage + ' %';
                finalPrice.textContent = formatVND(displayPrice);
            } else {
                finalPriceField.classList.add('d-none');
                percentagePriceReduceField.classList.add('d-none');
                finalPrice.textContent = '0 VND';
            }
        }

        function togglePriceFields() {
            const isPremiumSelected = document.getElementById('isPremiumYes').checked;
            if (isPremiumSelected) {
                priceField.classList.remove('d-none');
                salePriceField.classList.remove('d-none');
                priceInput.required = true;
            } else {
                priceField.classList.add('d-none');
                salePriceField.classList.add('d-none');
                priceInput.required = false;
                priceInput.value = ''; // Xóa giá trị khi ẩn
                salePriceInput.value = ''; // Xóa giá trị khi ẩn
            }
            updateFinalPrice();
        }

        const validatePrice = function () {
            // Chỉ validate nếu trường giá đang hiển thị (tức là isPremium = true)
            if (!priceField.classList.contains('d-none')) {
                const priceValue = parseInt(priceInput.value, 10);
                const salePriceValue = parseInt(salePriceInput.value, 10);

                if (isNaN(priceValue) || priceValue < 0) {
                    Swal.fire({
                        title: 'Cảnh báo',
                        text: 'Giá gốc phải là số dương!',
                        icon: 'warning',
                        confirmButtonText: 'OK'
                    });
                    priceInput.focus();
                    return false;
                }

                if (priceValue == 0) {
                    Swal.fire({
                        title: 'Nhắc nhở',
                        text: 'Nếu giá gốc của khóa học là 0 đồng thì bạn hãy chọn không phải khóa học premium!',
                        icon: 'warning',
                        confirmButtonText: 'OK'
                    });
                    priceInput.focus(); // Focus vào trường bị lỗi
                    return false;
                }

                // Nếu có giá giảm, kiểm tra nó không âm và không lớn hơn giá gốc
                if (!isNaN(salePriceValue)) { // Chỉ kiểm tra nếu salePrice có giá trị số
                    if (salePriceValue < 0) {
                        Swal.fire({
                            title: 'Cảnh báo',
                            text: 'Giá giảm không được âm!',
                            icon: 'warning',
                            confirmButtonText: 'OK'
                        });
                        salePriceInput.focus();
                        return false;
                    }
                    if (salePriceValue > priceValue) {
                        Swal.fire({
                            title: 'Cảnh báo',
                            text: 'Giá giảm không được lớn hơn giá gốc!',
                            icon: 'warning',
                            confirmButtonText: 'OK'
                        });
                        salePriceInput.focus();
                        return false;
                    }
                }
            }
            return true; // Validation thành công
        };

        premiumRadios.forEach(radio => {
            radio.addEventListener('change', togglePriceFields);
        });

        priceInput.addEventListener('input', updateFinalPrice);
        salePriceInput.addEventListener('input', updateFinalPrice);
        if (isPremiumYes) {
            isPremiumYes.addEventListener('change', updateFinalPrice);
        }
        const isPremiumNo = document.getElementById('isPremiumNo');
        if (isPremiumNo) {
            isPremiumNo.addEventListener('change', updateFinalPrice);
        }

        // Thêm sự kiện submit cho form
        form.addEventListener('submit', function (event) {
            if (!validatePrice()) {
                // Nếu validation thất bại, ngăn form gửi đi
                event.preventDefault();
            }
            // Nếu validate thành công, form sẽ được gửi đi bình thường
        });

        // Gọi hàm lần đầu để đảm bảo trạng thái đúng khi tải trang
        updateFinalPrice();
    });
</script>